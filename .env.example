# First-boot admin password: hashed and stored on startup, then REMOVE this line (ignored once a hash exists).
ADMIN_PASSWORD=
# CoinGecko Demo API key for live prices (free tier, sent as x-cg-demo-api-key).
COINGECKO_DEMO_KEY=
# SQLite database file path (Docker deploy uses /data/btc.db on the volume).
DATABASE_PATH=data/btc.db
# Production only (the dev server ignores these): the exact URL you open the app
# at, required for SvelteKit form-action CSRF checks, and the port it listens on.
ORIGIN=http://localhost:3000
PORT=3000
