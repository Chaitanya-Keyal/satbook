root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Generated by drizzle-kit and already applied; never reformat.
[drizzle/*.sql]
indent_style = unset
indent_size = unset
