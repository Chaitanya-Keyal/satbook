# The app's environment. Copy to .env next to compose.yml.

# First-boot admin password: hashed into the database on startup. Remove it once
# you have logged in, then `docker compose up -d` so the container drops it.
ADMIN_PASSWORD=
# The exact URL you will open — https, the device name from compose.yml, and
# your tailnet's DNS name (admin console → DNS). Form submissions from any other
# origin are rejected.
ORIGIN=https://satbook.your-tailnet.ts.net
# Optional: a free CoinGecko demo key raises the live-price rate limits.
COINGECKO_DEMO_KEY=
