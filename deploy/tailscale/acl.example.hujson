// A tailnet policy for satbook (admin console → Access controls), in the
// grants form Tailscale's default policy uses. Merge it into your own policy
// rather than pasting it over: the first grant replaces the default
// allow-everything grant, the rest is added.
//
// Why a policy is required, not optional: this Tailscale container runs in
// userspace mode, which forwards connections to EVERY port the app listens on.
// Without a policy that narrows it, any device on the tailnet can reach the app
// over plain HTTP on port 3000, past the HTTPS that `serve` puts on 443.
//
// The policy only binds if the satbook device is tagged (here tag:satbook):
// devices you own untagged are covered by autogroup:self, which allows every
// port. Tag it with a tagged auth key, or later via the device's "Edit ACL
// tags" menu.
{
  "tagOwners": {
    "tag:satbook": ["autogroup:admin"],
  },
  "grants": [
    // Your own untagged devices keep reaching each other on any port.
    // Tagged devices are not part of autogroup:self, so this does not
    // open satbook.
    {"src": ["autogroup:member"], "dst": ["autogroup:self"], "ip": ["*"]},

    // satbook: HTTPS only.
    {"src": ["autogroup:member"], "dst": ["tag:satbook"], "ip": ["tcp:443"]},
  ],
  // Checked on every save. Use your own login (e.g. name@github).
  "tests": [
    {
      "src": "you@example.com",
      "accept": ["tag:satbook:443"],
      "deny": ["tag:satbook:3000"],
    },
  ],
}
